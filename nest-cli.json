{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/loggigng-service/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/loggigng-service/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/loggigng-service",
  "projects": {

    "api-gateway": {
      "type": "application",
      "root": "apps/api-gateway",
      "entryFile": "main",
      "sourceRoot": "apps/api-gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api-gateway/tsconfig.app.json"
      }
    },
    
    "loggigng-service": {
      "type": "application",
      "root": "apps/loggigng-service",
      "entryFile": "main",
      "sourceRoot": "apps/loggigng-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/loggigng-service/tsconfig.app.json"
      }
    },
    
    "rider-service": {
      "type": "application",
      "root": "apps/rider-service",
      "entryFile": "main",
      "sourceRoot": "apps/rider-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/rider-service/tsconfig.app.json"
      }
    }
  }
}